# Copy to .env and fill in your Supabase project values.
# Never commit .env.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database password (Project Settings → Database). Local direct connection.
SUPABASE_DB_PASSWORD=your-database-password

# Session pooler URI — required for GitHub Actions migrations (see docs/supabase_setup.md)
# SUPABASE_DB_URL=postgresql://postgres.xxxxx:your-password@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: full Postgres URI instead of SUPABASE_URL + SUPABASE_DB_PASSWORD locally
# SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres
