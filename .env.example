# Copy to .env and fill in your Supabase project values.
# Never commit .env.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database password (Project Settings → Database). Local direct connection.
SUPABASE_DB_PASSWORD=

# Anthropic API key — scripts/generate_assessments.py (Slice 5b) uses it to write each
# card's prose "read" via Claude Haiku. Optional locally (the generator skips reads when
# unset); set ANTHROPIC_API_KEY as a Protected GitLab CI/CD variable for the scheduled pipeline.
ANTHROPIC_API_KEY=

# CI / pooler (recommended) — hostname and port from discover_supabase_db_host.py
# SUPABASE_DB_HOST=aws-0-eu-central-1.pooler.supabase.com
# SUPABASE_DB_PORT=5432

# Optional: Management API fallback for migrate script in CI (may 403 without scope)
# SUPABASE_ACCESS_TOKEN=sbp_...

# Alternative B: full Session pooler URI (see docs/supabase_setup.md)
# SUPABASE_DB_URL=postgresql://postgres.xxxxx:your-password@aws-0-REGION.pooler.supabase.com:5432/postgres

# Alternative C: local direct Postgres URI
# SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres
